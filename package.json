{
  "name": "@garc33/bitbucket-server-mcp-server",
  "version": "2.0.0",
  "description": "MCP Server for Bitbucket Server PR management",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garc33/bitbucket-server-mcp-server.git"
  },
  "homepage": "https://github.com/garc33/bitbucket-server-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/garc33/bitbucket-server-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bitbucket",
    "bitbucket-server",
    "bitbucket-data-center",
    "pull-request"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "bitbucket-server-mcp": "build/index.js"
  },
  "files": [
    "build",
    "!build/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"if (process.platform !== 'win32') require('child_process').execSync('chmod +x build/index.js')\"",
    "postinstall": "node -e \"const fs=require('fs'); if (process.platform !== 'win32' && fs.existsSync('build/index.js')) require('child_process').execSync('chmod +x build/index.js')\"",
    "start": "node build/index.js",
    "dev": "tsc -w",
    "dev:server": "npm run build && npx @modelcontextprotocol/inspector -e DEBUG=true node build/index.js",
    "test": "vitest",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.ts'",
    "update:check": "npx npm-check-updates",
    "update:deps": "npx npm-check-updates -u && npm install --legacy-peer-deps",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepublishOnly": "npm run lint && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
